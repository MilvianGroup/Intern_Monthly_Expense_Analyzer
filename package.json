{
  "name": "monthly-financial-project",
  "version": "1.0.0",
  "description": "Monthly financial analysis and reporting system",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "demo": "node src/index.js --demo",
    "auth": "node src/auth_server.js",
    "send-test-email": "node src/examples/send_email_oauth.js",
    "monitor": "node src/drive_monitor.js",
    "monitor:5min": "node src/drive_monitor.js 5",
    "monitor:setup": "node scripts/setup-monitor.js",
    "monitor:background": "node scripts/start-monitor.js",
    "monitor:background:5min": "node scripts/start-monitor.js 5",
    "monitor:daemon": "pm2 start config/ecosystem.config.js",
    "monitor:daemon:dev": "pm2 start config/ecosystem.config.js --env development",
    "monitor:stop": "pm2 stop expense-monitor",
    "monitor:status": "pm2 status expense-monitor",
    "monitor:logs": "pm2 logs expense-monitor",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.0.0",
    "@langchain/core": "^0.3.45",
    "@langchain/langgraph": "^0.2.65",
    "@smithy/eventstream-codec": "^4.0.2",
    "@smithy/signature-v4": "^5.1.0",
    "chart.js": "^4.0.0",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "googleapis": "^126.0.0",
    "langchain": "^0.1.0",
    "nodemailer": "^6.9.0",
    "puppeteer": "^21.0.0"
  },
  "devDependencies": {
    "pm2": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
