# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-west-2

# Demo Mode (set to true to use sample data)
DEMO_MODE=true

# Google API (optional, can use credentials file instead)
# GOOGLE_CREDENTIALS={"type":"service_account","project_id":"..."}

# Email Configuration
EMAIL_USER=your_gmail_address@gmail.com
# For Gmail, use an App Password, not your regular password
EMAIL_PASSWORD=your_app_password_here

# Email Configuration (optional, defaults to config.json)
# EMAIL_RECIPIENT=user@example.com

# Drive Monitor Configuration (optional)
# MONITOR_INTERVAL=15  # Check for new files every 15 minutes
