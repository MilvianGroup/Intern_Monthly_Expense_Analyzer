    "pdf": {
      "extraction_method": "bedrock",
      "max_pages": 20
    },
    "excel": {
      "sheet_name": "Expenses",
      "extraction_method": "bedrock"
    },
    "bank_statement": {
      "description": "Financial documents from banks showing account transactions, including OFX/QFX files and bank-provided PDFs with transaction details",
      "supported_formats": [".ofx", ".qfx", ".pdf", ".csv", ".xlsx"],
      "supported_banks": ["Bank of America", "Chase", "Wells Fargo", "Citibank"],
      "extraction_method": "bedrock",
      "transaction_types": {
        "expenses": ["debit", "payment", "withdrawal", "purchase"],
        "income": ["credit", "deposit", "refund", "transfer"]
      }
    }
  }
